# ═══════════════════════════════════════════════════════════════
#  Variables de entorno de la tienda
#  Local: copia este archivo a .env  ·  Railway: pestaña "Variables"
# ═══════════════════════════════════════════════════════════════

# ── Obligatorias ─────────────────────────────────────────────────
# Local: `npm run db` levanta Postgres en el puerto 5433 (sin Docker).
# Railway: usa la referencia ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://tienda:tienda@localhost:5433/tienda"

# Firma de las sesiones (clientes y admin). Mínimo 32 caracteres.
# Genera uno con: openssl rand -base64 32
AUTH_SECRET=""

# ── Tienda nueva (solo se usan la PRIMERA vez, cuando la base está vacía) ──
# Usuario dueño del panel /admin. Después cámbialo desde admin > Usuarios.
ADMIN_EMAIL="admin@mitienda.cl"
ADMIN_PASSWORD=""
STORE_NAME="Mi Tienda Eléctrica"
# plano | claro | cobre  (ver theme.config.ts)
THEME_PRESET="plano"
# Correo de contacto inicial (por defecto: ADMIN_EMAIL)
STORE_CONTACT_EMAIL=""

# ── URL pública (opcional) ────────────────────────────────────────
# En Railway se detecta sola (RAILWAY_PUBLIC_DOMAIN). Úsala con dominio propio.
APP_URL=""

# ── Imágenes ──────────────────────────────────────────────────────
# Opción A: S3 o compatible (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO).
# Si S3_BUCKET está vacío se usa la opción B.
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Endpoint para servicios compatibles (ej. R2: https://<cuenta>.r2.cloudflarestorage.com)
S3_ENDPOINT=""
# URL pública desde la que se sirven los archivos (ej. dominio público del bucket o CDN)
S3_PUBLIC_URL=""
# true para MinIO u otros que requieran path-style
S3_FORCE_PATH_STYLE="false"
# Opción B: disco local. En Railway monta un volumen (ej. en /data):
# se usa automáticamente RAILWAY_VOLUME_MOUNT_PATH/uploads.
UPLOAD_DIR=""

# ── Pagos (credenciales SOLO aquí, nunca en la base) ─────────────
# Webpay Plus (Transbank). Sin valores = ambiente de integración (pruebas).
# Producción: TRANSBANK_ENVIRONMENT=production + código de comercio y API key reales.
TRANSBANK_ENVIRONMENT="integration"
TRANSBANK_COMMERCE_CODE=""
TRANSBANK_API_KEY=""
# Mercado Pago (Checkout Pro). Pruebas: token TEST-…  Producción: APP_USR-…
MERCADOPAGO_ACCESS_TOKEN=""
# Clave secreta de webhooks (panel de Mercado Pago > Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=""

# ── Correo (SMTP) ────────────────────────────────────────────────
# Sin SMTP_HOST los correos se escriben en el log (la compra no falla).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# Remitente, ej: "Mi Tienda <ventas@mitienda.cl>"
SMTP_FROM=""
